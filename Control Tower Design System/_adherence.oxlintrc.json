{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/diagrams/**",
              "components/tower/**",
              "ui_kits/control-tower/**",
              "ui_kits/engineering-docs/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentAvatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|lane|size|withName|key|ref|className|style|children)$/]",
        "message": "<AgentAvatar> doesn't accept that prop. Declared props: name, lane, size, withName."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentAvatar'] > JSXAttribute[name.name='lane'] > Literal[value!=/^(?:pipeline|review|human|learning)$/]",
        "message": "<AgentAvatar> lane must be one of 'pipeline' | 'review' | 'human' | 'learning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|state|key|ref|className|style|children)$/]",
        "message": "<WorkStep> doesn't accept that prop. Declared props: label, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkStep'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|doing|todo)$/]",
        "message": "<WorkStep> state must be one of 'done' | 'doing' | 'todo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|full|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, full, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger|ok)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger' | 'ok'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:agent|gate|done)$/]",
        "message": "<Callout> tone must be one of 'agent' | 'gate' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:pending|done|active|agent|blocked|here|neutral)$/]",
        "message": "<Chip> tone must be one of 'pending' | 'done' | 'active' | 'agent' | 'blocked' | 'here' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|monoFirst|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, monoFirst."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:rule|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: rule, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|id|from|to|type|summary|isNew|onClick|key|ref|className|style|children)$/]",
        "message": "<FeedItem> doesn't accept that prop. Declared props: time, id, from, to, type, summary, isNew, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedItem'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:review-request|finding|question|answer|clarification|handoff|note|decision|escalation)$/]",
        "message": "<FeedItem> type must be one of 'review-request' | 'finding' | 'question' | 'answer' | 'clarification' | 'handoff' | 'note' | 'decision' | 'escalation'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GateCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:gate|target|title|brief|options|recommendation|evidence|kind|expanded|defaultExpanded|onApprove|onReject|onDiscuss|key|ref|className|style|children)$/]",
        "message": "<GateCard> doesn't accept that prop. Declared props: gate, target, title, brief, options, recommendation, evidence, kind, expanded, defaultExpanded, onApprove, onReject, onDiscuss."
      },
      {
        "selector": "JSXOpeningElement[name.name='GateCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:gate|escalation)$/]",
        "message": "<GateCard> kind must be one of 'gate' | 'escalation'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GateStop'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|key|ref|className|style|children)$/]",
        "message": "<GateStop> doesn't accept that prop. Declared props: label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IdCode'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<IdCode> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IdCode'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|inline|artifact)$/]",
        "message": "<IdCode> variant must be one of 'plain' | 'inline' | 'artifact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|tone|key|ref|className|style|children)$/]",
        "message": "<KpiItem> doesn't accept that prop. Declared props: value, label, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gate|agent|done|neutral)$/]",
        "message": "<KpiItem> tone must be one of 'gate' | 'agent' | 'done' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MermaidDiagram'] > JSXAttribute > JSXIdentifier[name!=/^(?:chart|caption|scroll|key|ref|className|style|children)$/]",
        "message": "<MermaidDiagram> doesn't accept that prop. Declared props: chart, caption, scroll."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|pad|flush|children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, meta, pad, flush, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PipelineRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|current|gate|holder|holderLane|onClick|key|ref|className|style|children)$/]",
        "message": "<PipelineRow> doesn't accept that prop. Declared props: id, name, current, gate, holder, holderLane, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PipelineRow'] > JSXAttribute[name.name='holderLane'] > Literal[value!=/^(?:pipeline|review|human|learning)$/]",
        "message": "<PipelineRow> holderLane must be one of 'pipeline' | 'review' | 'human' | 'learning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StageStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|gate|labels|compact|key|ref|className|style|children)$/]",
        "message": "<StageStrip> doesn't accept that prop. Declared props: current, gate, labels, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|key|ref|className|style|children)$/]",
        "message": "<StatusChip> doesn't accept that prop. Declared props: tone, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gate|agent|done|danger|muted)$/]",
        "message": "<StatusChip> tone must be one of 'gate' | 'agent' | 'done' | 'danger' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: kind, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:pipeline|review|human|learning)$/]",
        "message": "<Tag> kind must be one of 'pipeline' | 'review' | 'human' | 'learning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|status|claimedBy|approver|dependsOn|msgCount|onClick|key|ref|className|style|children)$/]",
        "message": "<TaskRow> doesn't accept that prop. Declared props: id, title, status, claimedBy, approver, dependsOn, msgCount, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:todo|claimed|in-progress|blocked|review|done)$/]",
        "message": "<TaskRow> status must be one of 'todo' | 'claimed' | 'in-progress' | 'blocked' | 'review' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:actor|lane|heading|last|children|key|ref|className|style|children)$/]",
        "message": "<TimelineItem> doesn't accept that prop. Declared props: actor, lane, heading, last, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineItem'] > JSXAttribute[name.name='lane'] > Literal[value!=/^(?:agent|human)$/]",
        "message": "<TimelineItem> lane must be one of 'agent' | 'human'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TraceStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|id|note|key|ref|className|style|children)$/]",
        "message": "<TraceStep> doesn't accept that prop. Declared props: kind, id, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='TraceStep'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:code|design|spec|task|dec|gate|rv|msg|intent)$/]",
        "message": "<TraceStep> kind must be one of 'code' | 'design' | 'spec' | 'task' | 'dec' | 'gate' | 'rv' | 'msg' | 'intent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|reviewer|verdict|key|ref|className|style|children)$/]",
        "message": "<VerdictBadge> doesn't accept that prop. Declared props: id, reviewer, verdict."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictBadge'] > JSXAttribute[name.name='verdict'] > Literal[value!=/^(?:approve|approve-with-notes|request-changes)$/]",
        "message": "<VerdictBadge> verdict must be one of 'approve' | 'approve-with-notes' | 'request-changes'."
      }
    ]
  },
